# Настройки сервера frudom.ru (пример без секретов). Настоящие значения — только в панели хостинга, не в GitHub.
PORT=3000
SITE_URL=https://frudom.ru
# Адрес веб-приложения Apps Script таблицы «Магазин Фруктовый Дом»
GS_URL=
# Сколько своих прокси стоит перед сайтом (Timeweb обычно 1). 0 — не верить X-Forwarded-For.
TRUST_PROXY=0
METRIKA_ID=
TILDA_ORIGIN=https://project8349547.tilda.ws
CATALOG_TTL_SEC=300
# Этап 3 (ещё не используется): Т-Банк — сначала ТЕСТОВЫЙ терминал
# TBANK_TERMINAL_KEY=
# TBANK_PASSWORD=
# TBANK_MODE=test
# Этап 2: база заказов. Пусто — заказы как раньше уходят сразу в Google Таблицу.
# На хостинге — облачная PostgreSQL Timeweb (пароль — отдельно, в ORDERS_DB_PASSWORD; сертификат certs/timeweb-cloud-ca.crt подставится сам):
#   postgres://gen_user@<адрес базы>.twc1.net:5432/default_db?sslmode=verify-full
# Для проверки на своём компьютере — путь к файлу SQLite (Node.js 22.5+), например ./data/orders.db
ORDERS_DB=
# Пароль базы (только в панели хостинга!)
ORDERS_DB_PASSWORD=
# Только для SQLite: папка ежедневных копий (хранятся 14). У PostgreSQL копии включаются в панели базы Timeweb.
ORDERS_BACKUP_DIR=
# С какого номера начинать заказы в базе (чтобы не путать с номерами из таблицы)
ORDER_NO_START=5001
# Кабинет менеджера /admin (работает только вместе с ORDERS_DB). Отпечаток пароля: node tools/hash-password.js
# ADMIN_USERS="Даниил:admin:scrypt$...;Наталья:manager:scrypt$...;Склад:viewer:scrypt$..."
ADMIN_USERS=
# 1 — cookie кабинета только по HTTPS (включить, когда сайт открыт по https)
COOKIE_SECURE=1
